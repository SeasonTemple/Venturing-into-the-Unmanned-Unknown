---
import Default from '@astrojs/starlight/components/Head.astro';
import interUrl from '../assets/fonts/inter-latin-wght.woff2?url';
import { ClientRouter } from 'astro:transitions';
import displayUrl from '../assets/fonts/instrument-serif-latin-400.woff2?url';
// 组件会被打包进 dist/.prerender，不能 import site.config.mjs（它按 import.meta.url 相对路径读 book.config.json）。
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Default><slot /></Default>
{/* 首屏用到的两款（正文 + 标题）预加载；等宽字体只在代码块出现，按需加载。 */}
<link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
<link rel="alternate" type="text/plain" href={BASE + '/llms.txt'} title="llms.txt" />
{/* 页面切换：Astro 内置 ClientRouter（View Transitions），跨页淡入淡出时长见 custom.css。 */}
<ClientRouter />
<script>
  import '../scripts/motion';
</script>
