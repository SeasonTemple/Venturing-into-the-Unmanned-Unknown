---
import {surveyRoutes,surveyTargets} from '../scripts/journal/chapter-surveys.mjs';
const {chapter,survey,headings}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/+$/,'');
const points=surveyRoutes[chapter.slug];
const nodes=survey.nodes.map((name,i)=>({name,point:points[i],heading:headings.find(h=>h.text.includes(surveyTargets[chapter.slug][i]))||headings[Math.floor(i*(headings.length-1)/2)]}));
const last=points.at(-1),unknown=[1290,490];
---
<figure id="chapter-art" class="chapter-art survey-poster" data-survey={chapter.slug}>
 <svg class="survey-map" viewBox="180 150 1460 660" role="group" aria-labelledby="survey-caption">
  <image href={base+'/journal/relief-base-v01.webp'} width="1920" height="1080" />
  <path class="chapter-trace" d={points.map(([x,y],i)=>`${i?'L':'M'}${x} ${y}`).join(' ')} />
  <path class="chapter-unresolved" d={`M${last[0]} ${last[1]}L${unknown[0]} ${unknown[1]}`} />
  {nodes.map(({name,point:[x,y],heading},i)=><a href={'#'+heading.slug} class="survey-node" aria-label={`${name}：${heading.text}`}>
   <circle class="node-halo" cx={x} cy={y} r="38" /><circle class="node-ring" cx={x} cy={y} r="13" /><circle class="node-core" cx={x} cy={y} r="4" />
   <path class="node-leader" d={`M${x} ${y-21}V${y-65}h18`} /><text x={x+26} y={y-62}><tspan class="node-number">0{i+1}</tspan><tspan class="node-title" dx="14">{name}</tspan></text>
  </a>)}
  <text class="survey-unknown" x={unknown[0]+20} y={unknown[1]}>{survey.unknown}</text>
 </svg>
 <nav class="survey-legend" aria-label="本章测绘节点">{nodes.map(({name,heading},i)=><a href={'#'+heading.slug}><span>0{i+1}</span>{name}</a>)}</nav>
 <figcaption id="survey-caption"><span>本章路线 / {survey.nodes.join(' → ')}</span><span>断线之外：{survey.unknown}</span></figcaption>
</figure>
