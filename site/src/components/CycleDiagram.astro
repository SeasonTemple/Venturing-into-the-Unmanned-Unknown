---
// AI-Native SDLC 闭环图：纯内联 SVG，不含位图；颜色只用 currentColor 与 CSS 变量，亮暗随主题自动切换。
// 六个阶段是本书方法论的固定骨架（src/lib/stages.ts，与首页路径条共用）；每个阶段链接到对应章节，章节号 / 路径取自 home.json（来自 book.config.json）。
// 视觉语言：工业图纸——1px 发丝线（vector-effect: non-scaling-stroke，缩放后仍是 1px）、同心细环 + 径向刻度、卡片顶部标题栏分隔线；无模糊光晕、无投影。
import home from '../generated/home.json';
import { stages } from '../lib/stages';
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const CX = 300, CY = 300, R = 205, NW = 136, NH = 84, MARGIN = 7;
const HEAD = 24; // 卡片顶部标题栏高度（CH 行）
const rad = (d: number) => (d * Math.PI) / 180;
const at = (deg: number) => [CX + R * Math.cos(rad(deg)), CY + R * Math.sin(rad(deg))] as const;
const f = (n: number) => n.toFixed(1);

const nodes = stages.map((s, i) => {
  const deg = -90 + 60 * i;
  const [x, y] = at(deg);
  const first = home.chapters.find((c) => c.order === s.orders[0]);
  return { ...s, i, deg, x, y, href: first ? BASE + '/' + first.slug + '/' : BASE + '/' };
});

// 沿圆环从节点 a 走到节点 b：离开节点矩形（外扩 MARGIN）为止，两端各裁一段。
const insideRect = (px: number, py: number, n: { x: number; y: number }) =>
  Math.abs(px - n.x) < NW / 2 + MARGIN && Math.abs(py - n.y) < NH / 2 + MARGIN;
function trimmed(a: (typeof nodes)[number], b: (typeof nodes)[number]) {
  let d0 = a.deg, d1 = a.deg + 60;
  while (insideRect(...at(d0), a)) d0 += 0.5;
  while (insideRect(...at(d1), b)) d1 -= 0.5;
  return [d0, d1] as const;
}
const arcs = nodes.map((n) => {
  const m = nodes[(n.i + 1) % nodes.length];
  const [d0, d1] = trimmed(n, m);
  const [x0, y0] = at(d0);
  const [x1, y1] = at(d1);
  // 箭头：沿切线方向的实心三角
  const t = rad(d1 + 90), nrm = rad(d1);
  const L = 13, W = 6.5;
  const bx = x1 - L * Math.cos(t), by = y1 - L * Math.sin(t);
  const head = `M${f(x1)} ${f(y1)}L${f(bx + W * Math.cos(nrm))} ${f(by + W * Math.sin(nrm))}L${f(bx - W * Math.cos(nrm))} ${f(by - W * Math.sin(nrm))}Z`;
  const [lx, ly] = at(n.deg + 30);
  return { i: n.i, d: `M${f(x0)} ${f(y0)}A${R} ${R} 0 0 1 ${f(x1 - 6 * Math.cos(t))} ${f(y1 - 6 * Math.sin(t))}`, head, lx, ly, label: n.handoff };
});

// 径向刻度：count 格，每 majorEvery 格一条长刻度（长度 majorLen），其余 minorLen；从内半径 r0 起算外伸（r0 为刻度内端）
function radial(r0: number, count: number, minorLen: number, majorEvery: number, majorLen: number, from = -90) {
  return Array.from({ length: count }, (_, k) => {
    const major = k % majorEvery === 0;
    const a = rad(from + (k * 360) / count);
    const r1 = r0 + (major ? majorLen : minorLen);
    return `M${f(CX + r0 * Math.cos(a))} ${f(CY + r0 * Math.sin(a))}L${f(CX + r1 * Math.cos(a))} ${f(CY + r1 * Math.sin(a))}`;
  }).join('');
}
// 外圈刻度：每 6° 一格，每 60°（节点方向）一条长刻度
const ticks = radial(262, 60, 6, 10, 14);
// 中心刻度环：r 104→122，每 5° 一格（72 格），每 30° 一条长刻度；四个正方向另画强调色长刻度
const hubTicks = radial(104, 72, 5, 6, 12);
const hubCardinal = radial(104, 4, 0, 1, 18);
const CIRC = 2 * Math.PI * R;
---

<svg class="mt-cycle" viewBox="18 18 564 564" role="group" aria-labelledby="mt-cycle-t mt-cycle-d" xmlns="http://www.w3.org/2000/svg">
  <title id="mt-cycle-t">AI-Native SDLC 闭环图</title>
  <desc id="mt-cycle-d">意图、设计、实现、验证、交付、演进六个阶段首尾相接成环；每个阶段链接到对应章节，演进阶段的运行信号回流为新的意图。</desc>

  <defs>
    <linearGradient id="mt-cycle-grad" gradientUnits="userSpaceOnUse" x1="60" y1="70" x2="540" y2="530">
      <stop class="mt-grad-a" offset="0" />
      <stop class="mt-grad-b" offset="1" />
    </linearGradient>
  </defs>

  <path class="mt-cycle-ticks" d={ticks} />
  <circle class="mt-cycle-ring" cx={CX} cy={CY} r={R} />

  <g class="mt-cycle-hub">
    <circle class="mt-hub-disc" cx={CX} cy={CY} r="104" />
    <circle class="mt-hub-outer" cx={CX} cy={CY} r="122" />
    <circle class="mt-hub-inner" cx={CX} cy={CY} r="104" />
    <path class="mt-hub-ticks" d={hubTicks} />
    <path class="mt-hub-cardinal" d={hubCardinal} />
  </g>

  <g class="mt-cycle-center" text-anchor="middle">
    <text class="mt-cycle-brand" x={CX} y={CY - 8}>AI-Native</text>
    <text class="mt-cycle-brand" x={CX} y={CY + 24}>SDLC</text>
    <text class="mt-cycle-note" x={CX} y={CY + 56}>人定意图与裁决</text>
    <text class="mt-cycle-note" x={CX} y={CY + 75}>Agent 执行与自检</text>
  </g>

  {arcs.map((a) => (
    <g class="mt-cycle-seg" style={`--i:${a.i}`}>
      <path class="mt-cycle-arc" d={a.d} />
      <path class="mt-cycle-head" d={a.head} />
      <g class="mt-cycle-handoff" text-anchor="middle">
        <rect x={a.lx - 37} y={a.ly - 12} width="74" height="24" rx="12" />
        <text x={a.lx} y={a.ly + 5}>{a.label}</text>
      </g>
    </g>
  ))}

  {/* 沿环流动的高光段：一段拖尾 + 一段亮头，顺时针绕环一周（6s）；画在节点之下，经过节点时被卡片遮住再从另一侧出现。 */}
  <g class="mt-cycle-pulse" aria-hidden="true" transform={`rotate(-90 ${CX} ${CY})`}>
    <circle class="mt-pulse-trail" cx={CX} cy={CY} r={R} style={`--len:${f(CIRC)}px`} />
    <circle class="mt-pulse-head" cx={CX} cy={CY} r={R} style={`--len:${f(CIRC)}px`} />
  </g>

  {nodes.map((n) => (
    <a class="mt-cycle-node" style={`--i:${n.i}`} href={n.href} aria-label={`${n.zh}（${n.en}）：第 ${n.orders.join('、')} 章`}>
      <rect class="mt-cycle-ring-hl" x={n.x - NW / 2 - 4} y={n.y - NH / 2 - 4} width={NW + 8} height={NH + 8} rx="10" />
      <rect class="mt-cycle-box" x={n.x - NW / 2} y={n.y - NH / 2} width={NW} height={NH} rx="6" />
      <line class="mt-cycle-rule" x1={n.x - NW / 2} x2={n.x + NW / 2} y1={n.y - NH / 2 + HEAD} y2={n.y - NH / 2 + HEAD} />
      <text class="mt-cycle-ch" x={n.x - NW / 2 + 11} y={n.y - NH / 2 + 16.5}>{'CH ' + n.orders.join('、')}</text>
      <text class="mt-cycle-zh" x={n.x} y={n.y + 12} text-anchor="middle">{n.zh}</text>
      <text class="mt-cycle-en" x={n.x} y={n.y + 31} text-anchor="middle">{n.en}</text>
    </a>
  ))}
</svg>

<style>
  .mt-cycle {
    /* 线条渐变：强调色 → 同色系浅一档（暗色在深底上取亮橙，亮色在白底上取深橙，各自 ≥3:1）。无光晕、无投影。 */
    --mt-grad-a: #ff7a3d;
    --mt-grad-b: #ffa070;
    --mt-pulse: #ffc29e;
    --mt-pulse-trail: #ff7a3d;
    --mt-edge: var(--sl-color-gray-4); /* 卡片 / 环线的默认发丝色：比 --mt-line-strong 再深一档，保证 1px 线在暗底上读得出 */
    --mt-cycle-delay: 480ms; /* 等 .mt-hero-art 自身的入场阶梯走完前半，再开始节点依次点亮 */
    display: block;
    width: 100%;
    height: auto;
    color: var(--sl-color-gray-2);
    overflow: visible;
  }
  :global(:root[data-theme='light']) .mt-cycle {
    --mt-grad-a: #a8330a;
    --mt-grad-b: #d4622a;
    --mt-pulse: #8f2f08;
    --mt-pulse-trail: #b93a0a;
  }
  .mt-grad-a {
    stop-color: var(--mt-grad-a);
  }
  .mt-grad-b {
    stop-color: var(--mt-grad-b);
  }
  /* 所有线条用 non-scaling-stroke：无论 SVG 被缩放到多大，发丝线都是 1px、连接线都是 1.5px */
  .mt-cycle-ticks,
  .mt-cycle-ring,
  .mt-hub-outer,
  .mt-hub-inner,
  .mt-hub-ticks,
  .mt-hub-cardinal,
  .mt-cycle-arc,
  .mt-cycle-box,
  .mt-cycle-rule,
  .mt-cycle-ring-hl,
  .mt-cycle-handoff rect {
    vector-effect: non-scaling-stroke;
  }
  .mt-cycle-ticks {
    fill: none;
    stroke: var(--mt-line-strong);
    stroke-width: 1;
  }
  .mt-cycle-ring {
    fill: none;
    stroke: var(--mt-edge);
    stroke-width: 1;
  }

  /* 中心：同心细环 + 径向刻度。外环 1px 强线、内环 1px 弱线、之间 72 格刻度（每 30° 一条长刻度），四个正方向强调色长刻度。 */
  .mt-hub-disc {
    fill: var(--mt-surface);
    stroke: none;
  }
  .mt-hub-outer {
    fill: none;
    stroke: var(--mt-edge);
    stroke-width: 1;
  }
  .mt-hub-inner {
    fill: none;
    stroke: var(--mt-line);
    stroke-width: 1;
  }
  .mt-hub-ticks {
    fill: none;
    stroke: var(--mt-line-strong);
    stroke-width: 1;
  }
  .mt-hub-cardinal {
    fill: none;
    stroke: var(--mt-accent);
    stroke-width: 1;
  }
  .mt-cycle-brand {
    fill: currentColor;
    color: var(--sl-color-white);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .mt-cycle-note {
    fill: currentColor;
    color: var(--sl-color-gray-3);
    font-size: 14px;
  }

  /* 连接线：2px 渐变虚线（旧版 3 个用户单位 ≈ 2.7px 外加光晕；改成 1.5px 反而变轻，所以取 2px 并去掉光晕），沿环流动。周期 14（9+5，屏幕像素），位移取 12 个周期 = 168，8s 线性无限，首尾无缝 */
  .mt-cycle-arc {
    fill: none;
    stroke: url(#mt-cycle-grad);
    stroke-width: 2;
    stroke-linecap: butt;
    stroke-dasharray: 9 5;
    animation: mt-flow 8s linear infinite;
  }
  .mt-cycle-head {
    fill: url(#mt-cycle-grad);
  }
  @keyframes mt-flow {
    to {
      stroke-dashoffset: -168;
    }
  }

  /* 沿环高光段：拖尾 96px + 亮头 28px，绕环一周 6s 线性。只动 stroke-dashoffset；整圈不发光，只有这一小段在走。 */
  .mt-pulse-trail,
  .mt-pulse-head {
    fill: none;
    stroke-linecap: round;
  }
  .mt-pulse-trail {
    stroke: var(--mt-pulse-trail);
    stroke-width: 2;
    opacity: 0.4;
    --o0: 0px;
    stroke-dasharray: 110px calc(var(--len) - 110px);
    stroke-dashoffset: var(--o0);
    animation: mt-orbit 6s linear infinite;
    animation-delay: calc(var(--mt-cycle-delay) + 700ms);
  }
  .mt-pulse-head {
    stroke: var(--mt-pulse);
    stroke-width: 3;
    --o0: -82px;
    stroke-dasharray: 28px calc(var(--len) - 28px);
    stroke-dashoffset: var(--o0);
    animation: mt-orbit 6s linear infinite;
    animation-delay: calc(var(--mt-cycle-delay) + 700ms);
  }
  @keyframes mt-orbit {
    from {
      stroke-dashoffset: var(--o0);
    }
    to {
      stroke-dashoffset: calc(var(--o0) - var(--len));
    }
  }

  /* 六个节点（及其后的连线段）按顺时针（自顶部起）每个延迟 80ms 淡入；只动 opacity */
  .mt-cycle-node,
  .mt-cycle-seg,
  .mt-cycle-pulse {
    animation: mt-fade-in 400ms ease-out backwards;
  }
  .mt-cycle-node {
    animation-delay: calc(var(--mt-cycle-delay) + var(--i) * 80ms);
  }
  .mt-cycle-seg {
    animation-delay: calc(var(--mt-cycle-delay) + var(--i) * 80ms + 120ms);
  }
  .mt-cycle-pulse {
    animation-delay: calc(var(--mt-cycle-delay) + 700ms);
  }
  @keyframes mt-fade-in {
    from {
      opacity: 0;
    }
  }

  .mt-cycle-handoff rect {
    fill: var(--sl-color-bg);
    stroke: var(--mt-line-strong);
    stroke-width: 1;
  }
  .mt-cycle-handoff text {
    fill: currentColor;
    color: var(--sl-color-gray-3);
    font-size: 13.5px;
    letter-spacing: 0.02em;
  }

  /* 节点卡片：默认 1px 发丝边框 + 顶部标题栏分隔线（图纸标题栏）；hover / 键盘焦点边框变 2px 强调色。 */
  .mt-cycle-node {
    cursor: pointer;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .mt-cycle-box {
    fill: var(--mt-surface);
    stroke: var(--mt-edge);
    stroke-width: 1;
    transition: stroke 160ms, stroke-width 160ms, fill 160ms;
  }
  .mt-cycle-rule {
    stroke: var(--mt-line);
    stroke-width: 1;
    transition: stroke 160ms;
  }
  .mt-cycle-node:is(:hover, :focus-visible) .mt-cycle-box {
    stroke: var(--mt-accent);
    stroke-width: 2;
    fill: var(--mt-surface-hover);
  }
  .mt-cycle-node:is(:hover, :focus-visible) .mt-cycle-rule {
    stroke: color-mix(in srgb, var(--mt-accent) 40%, transparent);
  }
  /* 键盘焦点另加一圈外环（2px，距卡片 4px），与悬停区分；悬停不出外环 */
  .mt-cycle-ring-hl {
    fill: none;
    stroke: var(--mt-accent);
    stroke-width: 2;
    opacity: 0;
  }
  .mt-cycle-node:focus-visible .mt-cycle-ring-hl {
    opacity: 1;
  }
  .mt-cycle-node:focus-visible {
    outline: none;
  }
  .mt-cycle-zh {
    fill: var(--sl-color-gray-1);
    font-size: 25px;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: fill 160ms;
  }
  .mt-cycle-node:is(:hover, :focus-visible) .mt-cycle-zh {
    fill: var(--sl-color-white);
  }
  .mt-cycle-en {
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mt-cycle-ch {
    fill: var(--mt-accent-text);
    font-family: var(--sl-font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  @media (max-width: 560px) {
    .mt-cycle-handoff {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mt-cycle-arc,
    .mt-cycle-node,
    .mt-cycle-seg {
      animation: none;
    }
    .mt-cycle-pulse {
      display: none;
    }
    .mt-cycle-box,
    .mt-cycle-rule,
    .mt-cycle-zh {
      transition: none;
    }
  }
</style>
