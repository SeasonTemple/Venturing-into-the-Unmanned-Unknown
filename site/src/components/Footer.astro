---
import Default from '@astrojs/starlight/components/Footer.astro';
// 组件会被打包进 dist/.prerender，不能 import site.config.mjs（它按 import.meta.url 相对路径读 book.config.json）。
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
const isJournal = /^ch[0-8A]$/.test(Astro.locals.starlightRoute.entry.id);
---

{!isJournal && <><Default><slot /></Default>
<p class="mt-llms">
  面向 AI / 爬虫：
  <a href={BASE + '/llms.txt'}>llms.txt</a>（章节索引）·
  <a href={BASE + '/llms-full.txt'}>llms-full.txt</a>（全文）
</p>
</>}

<style>
  .mt-llms {
    margin: 0.5rem 0 0;
    text-align: center;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .mt-llms a {
    color: var(--sl-color-gray-2);
  }
</style>
