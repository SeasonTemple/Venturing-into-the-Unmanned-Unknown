# 构建产物
dist/
book/
.build/
.scratch/

# 依赖
node_modules/

# Python 缓存与 Blender 自动备份
__pycache__/
*.pyc
*.pyo
*.blend1
*.blend2

# Starlight 站点（site/）
site/node_modules/
site/dist/
.astro/
# 由 site/scripts/sync.mjs 从 skills/*/SKILL.md 生成，不入库
site/src/content/docs/
site/src/generated/

# 工具产物（技能安装、生成器缓存、本地预览）
.agents/
.minimax/
.zcode/
skills-lock.json
.lab/

# 首屏候选图与临时素材（不入库）
.rev/
hero-candidates/
.shots/

# 研究过程默认不入库；仅源代码和明确登记的保留资产例外。
/tmp/
/temp/
/artifacts/
/outputs/
/captures/
/screenshots/
/docs/research/*-validation.json
/docs/research/*-checks.json
/docs/research/*-audit.json
/docs/research/*-study.json
/docs/research/*cleanup*.json
*.log
*.blend
*.blend1
*.blend2
*.ora
*.psd
*.ase
*.aseprite
*.zip
*.7z
*.tar
*.gz

